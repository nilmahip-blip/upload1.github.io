# Port the Node.js server listens on
PORT=3000
NODE_ENV=production
# Public origin, without trailing slash, e.g. https://files.example.com
APP_URL=http://localhost:3000

# Create this password yourself. Required for uploads/deletions; never expose it in public code.
ADMIN_PASSWORD=replace-with-a-long-random-password

# OAuth credentials from Google Cloud Console (OAuth client type: Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match this URL in Google Cloud OAuth redirect URIs:
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Optional: maximum upload size in MB
MAX_FILE_SIZE_MB=100
# Optional: folder name created in your Drive
DRIVE_FOLDER_NAME=Public Downloads
# Optional: set true only if you intentionally want to expose every uploaded file publicly
MAKE_FILES_PUBLIC=true
